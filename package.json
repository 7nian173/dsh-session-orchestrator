{
  "name": "dsh-session-orchestrator",
  "version": "0.1.0",
  "description": "Session orchestration for DeepSeek Harness in one bundle: a file queue another process can drive, workspace/stage session creation, cross-session delivery, one-shot UI navigation, a workspace-rooted mailbox, and session groups. Host half plus browser half.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/mail.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "README.zh.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "session",
    "orchestration",
    "cross-session",
    "file-queue",
    "navigation"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heartmove/dsh-session-orchestrator.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
