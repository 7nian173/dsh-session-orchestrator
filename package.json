{
  "name": "dsh-session-orchestrator",
  "version": "0.3.0",
  "description": "Session orchestration for DeepSeek Harness: a workspace mailbox with automatic receipts and expiry, session creation and hand-off, cross-session delivery, one-shot UI navigation, session groups, and an in-app settings page. Host half plus browser half. Agents: read docs/AGENT-GUIDE.md before using the mail tools.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/mail.js",
    "cordis.patch.yml",
    "README.md",
    "docs/AGENT-GUIDE.md",
    "LICENSE",
    "README.en.md",
    "docs/architecture.html",
    "docs/architecture.png",
    "tools/mail-push-test.mjs",
    "tools/mail-index-repair.mjs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "session",
    "orchestration",
    "cross-session",
    "file-queue",
    "navigation"
  ],
  "license": "CC-BY-NC-4.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "agentGuide": "docs/AGENT-GUIDE.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heartmove/dsh-session-orchestrator.git"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.2-0",
    "node": ">=20"
  }
}
